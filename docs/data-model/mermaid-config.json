{
  "theme": "base",
  "themeVariables": {
    "fontFamily": "Montserrat, Helvetica Neue, Arial, sans-serif",
    "fontSize": "14px",
    "primaryColor": "#FFFFFF",
    "primaryBorderColor": "#C7C7C7",
    "primaryTextColor": "#2A2A2A",
    "textColor": "#2A2A2A",
    "lineColor": "#69727d",
    "clusterBkg": "#EFEBFF",
    "clusterBorder": "#8072FF",
    "edgeLabelBackground": "#FFFFFF"
  },
  "themeCSS": ".cluster-label .nodeLabel { font-weight: 700; }",
  "flowchart": {
    "htmlLabels": true,
    "curve": "basis",
