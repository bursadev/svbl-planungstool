PORT=3001
# Comma-separated origins allowed by CORS (the web app, locally and deployed).
CORS_ORIGIN=http://localhost:3000

# Heroku sets DATABASE_URL, which overrides the DB_* connection settings below.
# DATABASE_URL=postgres://user:password@host:5432/dbname
# SSL defaults to on when DATABASE_URL is set, off otherwise.
# DB_SSL=false
DB_HOST=localhost
DB_PORT=5434
DB_USER=svbl
DB_PASSWORD=svbl
DB_NAME=svbl_planungstool
# Log SQL statements (true/false)
DB_LOGGING=false

# Clerk: secret key from the Clerk dashboard (API Keys), same instance as the web app.
CLERK_SECRET_KEY=sk_test_xxx
# Comma-separated origins allowed to obtain tokens for this API (the web app).
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# Role for signed-in accounts that have no publicMetadata.role in Clerk yet.
# Development only; ignored when NODE_ENV=production.
AUTH_DEFAULT_ROLE=planner

# Password for the two demo accounts created by `pnpm seed:users` (development instance only).
DEMO_USER_PASSWORD=
